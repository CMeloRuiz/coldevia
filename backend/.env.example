# Copia este archivo como .env y completa los valores.
NODE_ENV=development
PORT=4000

# --- CORS -----------------------------------------------------------------
# Orígenes que pueden llamar a la API, separados por comas y SIN barra final.
# Si se deja vacía, el backend usa la lista por defecto de src/config/env.js:
#   https://coldevia.com, https://www.coldevia.com,
#   https://coldevia.onrender.com, http://localhost:5173, http://127.0.0.1:5173
# En Render conviene definirla para poder cambiar los orígenes sin desplegar.
ALLOWED_ORIGINS=https://coldevia.com,https://www.coldevia.com,https://coldevia.onrender.com,http://localhost:5173

# --- Base de datos (Neon u otro PostgreSQL) -------------------------------
# Sin esta variable, las solicitudes del formulario se guardan en
# backend/data/contact-requests.jsonl para no perderlas durante el desarrollo.
DATABASE_URL=

# --- Correo (Resend) -------------------------------------------------------
# Sin API key o sin destinatario, la solicitud se guarda igual y el envío se omite.
RESEND_API_KEY=
# Remitente verificado en Resend
CONTACT_MAIL_FROM=ColdevIA <onboarding@resend.dev>
# Destinatarios de la notificación, separados por comas
CONTACT_MAIL_TO=
