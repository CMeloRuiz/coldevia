# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).
NODE_ENV=development
PORT=4000

# --- CORS -----------------------------------------------------------------
# Orígenes del sitio que pueden llamar a la API, separados por comas y SIN
# barra final. Si se deja vacía se usa la lista por defecto de src/config/env.js
# (https://coldevia.com, https://www.coldevia.com, http://localhost:5173).
FRONTEND_URL=https://coldevia.com,https://www.coldevia.com,http://localhost:5173

# --- Base de datos (Neon u otro PostgreSQL) -------------------------------
# Sin esta variable, las solicitudes del formulario se guardan en
# backend/data/contact-requests.jsonl para no perderlas durante el desarrollo.
DATABASE_URL=

# --- Correo (Resend) -------------------------------------------------------
# API key de https://resend.com/api-keys
RESEND_API_KEY=
# Remitente verificado en Resend. Mientras no se verifique coldevia.com sirve
# onboarding@resend.dev, que solo puede escribirle al correo de la cuenta.
CONTACT_FROM_EMAIL=ColdevIA <onboarding@resend.dev>
# Destinatario(s) del aviso, separados por comas. Hoy es un correo personal
# temporal; cuando haya buzón profesional basta con cambiar esta variable.
CONTACT_TO_EMAIL=

# --- Límite de envíos por IP (opcional) ------------------------------------
CONTACT_RATE_MAX=5
CONTACT_RATE_WINDOW_MS=3600000
