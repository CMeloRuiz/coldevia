# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).
NODE_ENV=development
PORT=4000

# --- CORS -----------------------------------------------------------------
# Orígenes del sitio que pueden llamar a la API, separados por comas y SIN
# barra final. Si se deja vacía se usa la lista por defecto de src/config/env.js
# (https://coldevia.com, https://www.coldevia.com, http://localhost:5173).
FRONTEND_URL=https://coldevia.com,https://www.coldevia.com,http://localhost:5173

# --- Correo (Resend) -------------------------------------------------------
# API key de https://resend.com/api-keys (empieza por re_). Sin ella, el
# formulario responde error en vez de dar por enviada una solicitud.
RESEND_API_KEY=

# Destinatario del aviso. Varios separados por comas.
CONTACT_TO_EMAIL=

# Remitente. Opcional: si se omite se usa ColdevIA <ventas@coldevia.com>, que
# es el buzón del dominio ya verificado en Resend (SPF, DKIM y DMARC).
CONTACT_FROM_EMAIL=

# --- Base de datos (Neon u otro PostgreSQL) -------------------------------
# Opcional y todavía sin configurar. Sin esta variable las solicitudes se
# escriben en backend/data/contact-requests.jsonl, que sirve en desarrollo
# pero NO en Render: el disco es efímero y se borra en cada despliegue.
DATABASE_URL=

# --- Límite de envíos por IP (opcional) ------------------------------------
CONTACT_RATE_MAX=5
CONTACT_RATE_WINDOW_MS=3600000
