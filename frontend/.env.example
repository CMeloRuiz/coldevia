# Copia este archivo como .env.local (desarrollo) y configura las mismas
# claves en el panel del hosting para producción. Los .env NO se suben al
# repositorio; solo las variables que empiezan por VITE_ llegan al navegador.

# URL pública de la API.
#
# DESARROLLO: déjala vacía. Vite redirige /api a http://localhost:4000
#             (ver la sección `server.proxy` de vite.config.js).
# PRODUCCIÓN: la URL del servicio de la API en Render, sin barra final.
#             Ejemplo: https://coldevia-api.onrender.com
VITE_API_URL=
